@model IEnumerable<RaceDay.Contracts.CategoryDto>
@{
    ViewData["Title"] = "Manage Categories";
    var ev = ViewBag.Event as RaceDay.Contracts.EventDto;
}

<div class="container mt-4">
    <h2>Categories for @ev?.Name</h2>
    <a asp-action="Events" class="btn btn-secondary mb-3">Back to Events</a>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="row">
        <!-- List existing categories -->
        <div class="col-md-6">
            <h4>Existing Categories</h4>
            @if (!Model.Any())
            {
                <p>No categories yet.</p>
            }
            else
            {
                <ul class="list-group mb-4">
                    @foreach (var cat in Model)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            @cat.Name - R@cat.EntryFee
                        </li>
                    }
                </ul>
            }
        </div>

        <!-- Add new category form -->
        <div class="col-md-6">
            <h4>Add New Category</h4>
            <form asp-action="AddCategory" method="post">
                <input type="hidden" name="eventId" value="@ev?.EventId" />
                <div class="mb-3">
                    <label class="form-label">Category Name (e.g., Open Male, 10km)</label>
                    <input name="Name" class="form-control" required />
                </div>
                <div class="mb-3">
                    <label class="form-label">Description</label>
                    <input name="Description" class="form-control" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Entry Fee (R)</label>
                    <input name="EntryFee" type="number" step="0.01" class="form-control" required />
                </div>
                <button type="submit" class="btn btn-success">Add Category</button>
            </form>
        </div>
    </div>
</div>