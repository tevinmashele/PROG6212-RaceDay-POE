@model IEnumerable<RaceDay.Contracts.EventDto>

@{
    ViewData["Title"] = "My Events";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>My Events</h2>
        <a asp-action="CreateEvent" class="btn btn-success">Create New Event</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info">You haven't created any events yet.</div>
    }
    else
    {
        <table class="table table-striped table-hover shadow-sm">
            <thead class="table-dark">
                <tr>
                    <th>Event Name</th>
                    <th>Date</th>
                    <th>Location</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var ev in Model)
                {
                    <tr>
                        <td>@ev.Name</td>
                        <td>@ev.EventDate.ToString("yyyy-MM-dd")</td>
                        <td>@ev.Location</td>
                        <td>
                            <a asp-action="ManageCategories" asp-route-eventId="@ev.EventId" class="btn btn-sm btn-info text-white">Categories</a>
                            <a asp-action="Enrolments" asp-route-eventId="@ev.EventId" class="btn btn-sm btn-primary">Enrolments</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>