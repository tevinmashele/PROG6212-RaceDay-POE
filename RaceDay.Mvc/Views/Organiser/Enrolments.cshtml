@model IEnumerable<RaceDay.Contracts.EnrolmentDto>
@{
    ViewData["Title"] = "Event Enrolments";
    var ev = ViewBag.Event as RaceDay.Contracts.EventDto;
}

<div class="container mt-4">
    <h2>Enrolments for @ev?.Name</h2>
    <a asp-action="Events" class="btn btn-secondary mb-3">Back to Events</a>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info">No participants have enrolled in this event yet.</div>
    }
    else
    {
        <table class="table table-bordered shadow-sm">
            <thead class="table-dark">
                <tr>
                    <th>Participant</th>
                    <th>Category</th>
                    <th>Status</th>
                    <th>Capture Result</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.ParticipantName</td>
                        <td>@item.CategoryName</td>
                        <td><span class="badge bg-success">@item.Status</span></td>
                        <td>
                            <form asp-action="CaptureResult" method="post" class="d-flex gap-2">
                                <input type="hidden" name="eventId" value="@ev?.EventId" />
                                <input type="hidden" name="EnrolmentId" value="@item.EnrolmentId" />

                                <input name="FinishTime" class="form-control form-control-sm" placeholder="e.g. 02:15:00" required style="width: 120px;" />
                                <input name="FinishPosition" type="number" class="form-control form-control-sm" placeholder="Position" required style="width: 90px;" />

                                <button type="submit" class="btn btn-sm btn-success">Save</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>